<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ThirdLife.Policy\ThirdLife.Policy.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\fixtures\policies\community-laptop-policy.json"
          Link="community-laptop-policy.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\fixtures\policies\historical\community-laptop-policy-v1.json"
          Link="community-laptop-policy-v1.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
