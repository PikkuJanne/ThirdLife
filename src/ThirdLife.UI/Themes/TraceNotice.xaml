<Window x:Class="ThirdLife.UI.Themes.TraceNotice" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480" MaxHeight="420" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Trace.BgCanvasBrush}" Foreground="{DynamicResource Trace.TextPrimaryBrush}"
        FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}" FontSize="{DynamicResource Trace.TypeUi}"
        FocusManager.FocusedElement="{Binding ElementName=DismissButton}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Border Background="{DynamicResource Trace.BgSurfaceBrush}" Padding="{DynamicResource Trace.Inset24}"
            CornerRadius="{DynamicResource Trace.RadiusFloating}">
      <StackPanel>
        <TextBlock x:Name="Heading" Style="{DynamicResource Trace.TitleText}" AutomationProperties.HeadingLevel="Level1" />
        <TextBlock x:Name="Message" Margin="0,12,0,16" />
        <Button x:Name="DismissButton" Content="Close" Style="{DynamicResource Trace.PrimaryButton}"
                HorizontalAlignment="Right" IsDefault="True" IsCancel="True" />
      </StackPanel>
    </Border>
  </ScrollViewer>
</Window>
