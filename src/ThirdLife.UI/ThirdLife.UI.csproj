<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.manifest" LogicalName="ThirdLife.UI.app.manifest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ThirdLife.Core\ThirdLife.Core.csproj" />
    <ProjectReference Include="..\ThirdLife.Inventory\ThirdLife.Inventory.csproj" />
    <ProjectReference Include="..\ThirdLife.Persistence\ThirdLife.Persistence.csproj" />
  </ItemGroup>

</Project>
