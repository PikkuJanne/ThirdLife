<UserControl x:Class="ThirdLife.UI.Features.Recovery.RebootRecoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="RecoveryVisibility" />
  </UserControl.Resources>
  <GroupBox Header="Restart recovery" AutomationProperties.Name="Restart recovery"
            Visibility="{Binding HasRebootRecovery, Converter={StaticResource RecoveryVisibility}}">
    <StackPanel>
      <StackPanel Visibility="{Binding HasPendingRebootRecovery, Converter={StaticResource RecoveryVisibility}}">
        <TextBlock Text="The saved action requires fresh verification. Resuming opens it for review without running it again."
                   TextWrapping="Wrap" />
        <Label Target="{Binding ElementName=RecoveryChoice}" Content="Saved restart checkpoint" />
        <ComboBox x:Name="RecoveryChoice" ItemsSource="{Binding RebootRecoveryChoices}"
                  SelectedItem="{Binding SelectedRebootRecovery}" DisplayMemberPath="Label"
                  AutomationProperties.Name="Saved restart checkpoint" />
        <WrapPanel>
          <Button x:Name="ResumeButton" Content="Resume for review" Click="Resume"
                  IsEnabled="{Binding CanResumeRebootRecovery}" Margin="0,0,8,4" />
          <Button x:Name="AbandonButton" Content="Abandon resume" Click="Abandon"
                  IsEnabled="{Binding CanAbandonRebootRecovery}" Margin="0,0,0,4" />
        </WrapPanel>
      </StackPanel>
      <TextBlock x:Name="DecisionStatus" Text="{Binding RebootRecoveryStatus, NotifyOnTargetUpdated=True}"
                 TargetUpdated="AnnounceStatus" Focusable="True" KeyboardNavigation.IsTabStop="False"
                 TextWrapping="Wrap" AutomationProperties.Name="{Binding RebootRecoveryStatus}"
                 AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
  </GroupBox>
</UserControl>
