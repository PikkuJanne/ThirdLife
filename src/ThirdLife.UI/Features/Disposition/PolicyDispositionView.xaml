<UserControl x:Class="ThirdLife.UI.Features.Disposition.PolicyDispositionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="PolicyOutcomeVisibility" />
  </UserControl.Resources>
  <GroupBox Header="Policy disposition" AutomationProperties.Name="Policy disposition">
    <StackPanel>
      <TextBlock Text="Candidate policy results are for workshop review." TextWrapping="Wrap" />
      <WrapPanel Margin="0,6,0,0">
        <Button x:Name="EvaluatePolicyButton" Content="Evaluate candidate policy"
                IsEnabled="{Binding CanEvaluatePolicy}" Click="EvaluatePolicy" Margin="0,0,8,4" />
        <Button x:Name="ReevaluatePolicyButton" Content="Reevaluate candidate policy"
                IsEnabled="{Binding CanReevaluatePolicy}" Click="ReevaluatePolicy" Margin="0,0,0,4" />
      </WrapPanel>
      <TextBlock x:Name="PolicyStatusMessage" Text="{Binding PolicyStatus, NotifyOnTargetUpdated=True}" TextWrapping="Wrap"
                 AutomationProperties.LiveSetting="Polite" TargetUpdated="AnnounceStatus" />
      <StackPanel Margin="0,8,0,0" Visibility="{Binding HasPolicyDecision, Converter={StaticResource PolicyOutcomeVisibility}}">
        <TextBlock x:Name="PolicyResultTitle" Text="{Binding PolicyDispositionTitle}" TextWrapping="Wrap"
                   Focusable="True" KeyboardNavigation.IsTabStop="True" FontWeight="SemiBold" />
        <TextBlock Text="{Binding PolicyDispositionSummary}" TextWrapping="Wrap" />
        <Expander x:Name="PolicyExpertExpander" Header="Policy and evidence details"
                  AutomationProperties.Name="Policy and evidence details"
                  Expanded="ExpandExpertDetails" IsVisibleChanged="ResetHiddenDetails">
          <TextBox x:Name="PolicyExpertText" Text="{Binding PolicyExpertDetails, Mode=OneWay}"
                   TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" MaxHeight="280"
                   VerticalScrollBarVisibility="Auto" PreviewKeyDown="CloseExpertDetailsOnEscape"
                   AutomationProperties.Name="Saved policy and evidence details"
                   AutomationProperties.HelpText="Press Escape to close the details and return to the heading." />
        </Expander>
      </StackPanel>
    </StackPanel>
  </GroupBox>
</UserControl>
