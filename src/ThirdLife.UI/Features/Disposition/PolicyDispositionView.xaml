<UserControl x:Class="ThirdLife.UI.Features.Disposition.PolicyDispositionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:disposition="clr-namespace:ThirdLife.UI.Features.Disposition"
             Focusable="True" KeyboardNavigation.IsTabStop="False"
             AutomationProperties.Name="Review the device disposition">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="PolicyOutcomeVisibility" />
  </UserControl.Resources>
  <StackPanel>
    <TextBlock Text="Review the device disposition"
               Style="{DynamicResource Trace.TitleText}"
               AutomationProperties.HeadingLevel="Level1" />
    <TextBlock Text="Evaluate the saved assessment against the current candidate policy for workshop review."
               TextWrapping="Wrap" Margin="0,4,0,16" />

    <Border Style="{DynamicResource Trace.EvidencePanel}">
      <StackPanel>
        <TextBlock x:Name="PolicyStatusMessage" Text="{Binding PolicyStatus, NotifyOnTargetUpdated=True}"
                   TextWrapping="Wrap" Style="{DynamicResource Trace.MetaText}"
                   AutomationProperties.LiveSetting="Polite" TargetUpdated="AnnouncePolicyStatus" />
        <StackPanel Margin="0,8,0,0"
                    Visibility="{Binding HasPolicyDecision, Converter={StaticResource PolicyOutcomeVisibility}}">
          <TextBlock x:Name="PolicyResultTitle" Text="{Binding PolicyDispositionTitle}" TextWrapping="Wrap"
                     Focusable="True" KeyboardNavigation.IsTabStop="True"
                     Style="{DynamicResource Trace.TitleText}" AutomationProperties.HeadingLevel="Level2" />
          <TextBlock Text="{Binding PolicyDispositionSummary}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
      </StackPanel>
    </Border>

    <StackPanel Margin="0,16,0,0"
                Visibility="{Binding HasPolicyDecision, Converter={StaticResource PolicyOutcomeVisibility}}">
      <StackPanel Visibility="{Binding HasPolicyControllingReasons, Converter={StaticResource PolicyOutcomeVisibility}}">
        <TextBlock Text="Controlling rules" Style="{DynamicResource Trace.SectionText}"
                   AutomationProperties.HeadingLevel="Level2" />
        <TextBlock Text="{Binding PolicyControllingReasons}" TextWrapping="Wrap" Margin="0,4,0,12" />
      </StackPanel>
      <Expander x:Name="PolicyExpertExpander" Header="Policy and evidence details"
                AutomationProperties.Name="Policy and evidence details"
                Expanded="ExpandExpertDetails" IsVisibleChanged="ResetHiddenDetails">
        <TextBox x:Name="PolicyExpertText" Text="{Binding PolicyExpertDetails, Mode=OneWay}"
                 TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" MaxHeight="280"
                 VerticalScrollBarVisibility="Auto" PreviewKeyDown="CloseExpertDetailsOnEscape"
                 AutomationProperties.Name="Saved policy and evidence details"
                 AutomationProperties.HelpText="Press Escape to close the details and return to the heading." />
      </Expander>
    </StackPanel>

    <Border Style="{DynamicResource Trace.ActionArea}" Margin="0,16,0,16">
      <StackPanel>
        <TextBlock Text="{Binding PolicyEvaluationRestriction}" TextWrapping="Wrap"
                   Style="{DynamicResource Trace.AttentionText}" />
        <TextBlock x:Name="PolicyActionMessage" TextWrapping="Wrap" Focusable="True"
                   KeyboardNavigation.IsTabStop="False" AutomationProperties.LiveSetting="Polite" />
        <Button x:Name="EvaluatePolicyButton" Content="Evaluate candidate policy"
                IsEnabled="{Binding CanEvaluatePolicy}" Click="EvaluatePolicy"
                Style="{DynamicResource Trace.PrimaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0"
                Visibility="{Binding IsPolicyEvaluationPending, Converter={StaticResource PolicyOutcomeVisibility}}" />
        <Button x:Name="ReevaluatePolicyButton" Content="Reevaluate candidate policy"
                IsEnabled="{Binding CanReevaluatePolicy}" Click="ReevaluatePolicy"
                Style="{DynamicResource Trace.PrimaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0"
                Visibility="{Binding HasPolicyDecision, Converter={StaticResource PolicyOutcomeVisibility}}" />
      </StackPanel>
    </Border>

    <disposition:RepairWorkflowView />
  </StackPanel>
</UserControl>
