<UserControl x:Class="ThirdLife.UI.Features.Disposition.RepairWorkflowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Expander Header="Repair and retest" AutomationProperties.Name="Repair and retest">
    <StackPanel>
      <Label Content="Device class" Target="{Binding ElementName=DeviceClassInput}" />
      <ComboBox x:Name="DeviceClassInput" DisplayMemberPath="Caption" SelectedValuePath="Value"
                SelectedValue="{Binding RepairDeviceClass, Mode=TwoWay}"
                IsEnabled="{Binding CanEditJob}" AutomationProperties.Name="Device class" />
      <TextBlock Text="{Binding RepairPolicyStatus}" TextWrapping="Wrap" />

      <Label Content="Saved finding for completed work" Target="{Binding ElementName=RepairFindingInput}" />
      <ComboBox x:Name="RepairFindingInput" ItemsSource="{Binding RepairCandidates}"
                DisplayMemberPath="Caption" MaxDropDownHeight="240" IsEnabled="{Binding CanRecordRepair}"
                AutomationProperties.Name="Saved finding for completed work" />
      <Label Content="Completed work" Target="{Binding ElementName=RepairActionInput}" />
      <ComboBox x:Name="RepairActionInput" DisplayMemberPath="Caption" IsEnabled="{Binding CanRecordRepair}"
                AutomationProperties.Name="Completed work" />
      <Label Content="Repair operator code" Target="{Binding ElementName=RepairOperatorInput}" />
      <TextBox x:Name="RepairOperatorInput" MaxLength="128" IsEnabled="{Binding CanRecordRepair}"
               AutomationProperties.Name="Repair operator code" />
      <Button Content="Record completed repair" IsEnabled="{Binding CanRecordRepair}" Click="RecordRepair" />

      <Label Content="Saved repair to retest" Target="{Binding ElementName=SavedRepairInput}" />
      <ComboBox x:Name="SavedRepairInput" ItemsSource="{Binding SavedRepairs}" DisplayMemberPath="Caption"
                MaxDropDownHeight="240" IsEnabled="{Binding CanEditJob}"
                AutomationProperties.Name="Saved repair to retest" />
      <Button Content="Start linked read-only retest" IsEnabled="{Binding CanStartRetest}" Click="StartRetest" />
      <TextBlock x:Name="RepairInputMessage" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />

      <Expander Header="Saved repairs and retests" AutomationProperties.Name="Saved repairs and retests">
        <ListBox ItemsSource="{Binding RepairHistory}" MaxHeight="180"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="Repair and retest history">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" TextWrapping="Wrap" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Expander>
    </StackPanel>
  </Expander>
</UserControl>
