<UserControl x:Class="ThirdLife.UI.Features.ManualTests.AuditWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:disposition="clr-namespace:ThirdLife.UI.Features.Disposition"
             xmlns:plan="clr-namespace:ThirdLife.UI.Features.PlanReview"
             xmlns:execution="clr-namespace:ThirdLife.UI.Features.Execution"
             xmlns:evidence="clr-namespace:ThirdLife.Core.Evidence;assembly=ThirdLife.Core"
             xmlns:handover="clr-namespace:ThirdLife.Core.Handover;assembly=ThirdLife.Core"
  xmlns:finalization="clr-namespace:ThirdLife.Core.Finalization;assembly=ThirdLife.Core"
             xmlns:manual="clr-namespace:ThirdLife.Core.ManualTests;assembly=ThirdLife.Core"
             xmlns:sanitization="clr-namespace:ThirdLife.Core.Sanitization;assembly=ThirdLife.Core">  <StackPanel>
    <Border x:Name="JobHeader" Visibility="Collapsed" Padding="24,12"
            BorderBrush="{DynamicResource Trace.BorderPassiveBrush}" BorderThickness="0,0,0,1">
      <StackPanel>
        <DockPanel LastChildFill="True">
          <Button x:Name="CloseJobButton" DockPanel.Dock="Right" Content="Close job" Click="CloseJob"
                  IsEnabled="{Binding CanCloseJob}" Margin="12,0,0,0" VerticalAlignment="Center" />
          <Label x:Name="JobIdentity" Content="Workshop job" Target="{Binding ElementName=CurrentJobId}" FontWeight="SemiBold" Padding="0,0,0,4" />
        </DockPanel>
        <TextBox x:Name="CurrentJobId" Text="{Binding JobId, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                 BorderThickness="0" Padding="0" Background="Transparent" MinHeight="20"
                 AutomationProperties.Name="Current job identifier" />
        <TextBlock x:Name="JobState" Style="{DynamicResource Trace.MetaText}" />
      </StackPanel>
    </Border>

    <Border x:Name="OperationErrorRegion" Visibility="Collapsed" Margin="24,12,24,0"
            Style="{DynamicResource Trace.ActionArea}">
      <TextBlock x:Name="OperationErrorMessage" Text="{Binding OperationError}" Style="{DynamicResource Trace.ErrorText}"
                 AutomationProperties.Name="{Binding OperationError}" AutomationProperties.LiveSetting="Polite" />
    </Border>

    <Grid x:Name="StageContent" Margin="{DynamicResource Trace.Inset24}">
      <StackPanel x:Name="JobRegion" Focusable="True" KeyboardNavigation.IsTabStop="False">
        <TextBlock Text="Open a workshop job" Style="{DynamicResource Trace.TitleText}" AutomationProperties.HeadingLevel="Level1" />
        <TextBlock Text="Create a job or open one by its workshop job code." Margin="0,8,0,16" />
        <TextBlock x:Name="FixtureNotice" Visibility="Collapsed" Style="{DynamicResource Trace.AttentionText}" Margin="0,0,0,8"
                   Text="Isolated fixture scenario. Synthetic assessment evidence describes this scenario only." />
        <Button x:Name="CreateJobButton" Content="Create job" Click="CreateJob" Style="{DynamicResource Trace.PrimaryButton}"
                HorizontalAlignment="Left" />
        <GroupBox Header="Open by job code" MaxWidth="620" HorizontalAlignment="Left" MinWidth="220" Margin="0,16,0,0">
          <StackPanel>
            <Label Target="{Binding ElementName=JobIdInput}" Content="Workshop job code" />
            <TextBox x:Name="JobIdInput" MaxLength="80" AutomationProperties.Name="Job identifier to open" />
            <Button x:Name="OpenJobButton" Content="Open job" Click="OpenJob" HorizontalAlignment="Left" />
          </StackPanel>
        </GroupBox>
        <TextBlock x:Name="AuditStatus" Text="{Binding JobEntryStatus}" Margin="0,12,0,0" Focusable="True"
                   AutomationProperties.Name="{Binding JobEntryStatus}" AutomationProperties.LiveSetting="Polite" />
      </StackPanel>

      <StackPanel x:Name="IntakeSurface" Visibility="Collapsed">
        <TextBlock Text="Record the external result" Style="{DynamicResource Trace.TitleText}" AutomationProperties.HeadingLevel="Level1" />
    <GroupBox x:Name="SanitizationRegion" Header="External sanitization" Focusable="True"
              KeyboardNavigation.IsTabStop="False" AutomationProperties.Name="External sanitization">
      <StackPanel>
        <TextBlock x:Name="SanitizationInstructions"
                   Text="Confirm lawful ownership and record the result from the work done outside ThirdLife. If ownership or sanitization is uncertain, leave assessment blocked." />
        <Border Style="{DynamicResource Trace.ActionArea}" Margin="0,12,0,12">
          <StackPanel>
            <TextBlock x:Name="SavedSanitization" FontWeight="SemiBold" />
            <TextBlock Text="{Binding GateStatus}" Style="{DynamicResource Trace.MetaText}" Margin="0,4,0,0" />
          </StackPanel>
        </Border>
        <StackPanel x:Name="SanitizationFields" IsEnabled="{Binding CanEditJob}">
          <Label Target="{Binding ElementName=OperatorIdInput}" Content="Workshop operator code" />
          <TextBlock Text="Use a short local code. Leave out names, email addresses and other personal details." />
          <TextBox x:Name="OperatorIdInput" MaxLength="64"
                   AutomationProperties.Name="Workshop operator code" />
          <Label Target="{Binding ElementName=SanitizationResult}" Content="External result" />
          <ComboBox x:Name="SanitizationResult" SelectedValuePath="Tag"
                    SelectionChanged="SanitizationResultChanged"
                    AutomationProperties.Name="External sanitization result">
            <ComboBoxItem Content="Unknown" Tag="{x:Static sanitization:SanitizationState.Unknown}" />
            <ComboBoxItem Content="Sanitized and verified" Tag="{x:Static sanitization:SanitizationState.Verified}" />
            <ComboBoxItem Content="Replacement storage verified" Tag="{x:Static sanitization:SanitizationState.ReplacementStorage}" />
            <ComboBoxItem Content="Verified no donor storage" Tag="{x:Static sanitization:SanitizationState.NoDonorStorage}" />
            <ComboBoxItem Content="Verification failed" Tag="{x:Static sanitization:SanitizationState.Failed}" />
          </ComboBox>
          <StackPanel x:Name="SanitizationMethodFields" Visibility="Collapsed">
            <Label Target="{Binding ElementName=SanitizationMethod}" Content="External method used" />
            <ComboBox x:Name="SanitizationMethod" SelectedValuePath="Tag"
                      AutomationProperties.Name="External sanitization method">
              <ComboBoxItem Content="Clear" Tag="clear" />
              <ComboBoxItem Content="Purge" Tag="purge" />
              <ComboBoxItem Content="Destroy" Tag="destroy" />
            </ComboBox>
          </StackPanel>
          <StackPanel x:Name="SanitizationEventFields" Visibility="Collapsed">
            <Label Target="{Binding ElementName=SanitizationDate}" Content="Date of external result" />
            <DatePicker x:Name="SanitizationDate" AutomationProperties.Name="Date of external sanitization result"
                        DateValidationError="InvalidSanitizationDate" SelectedDateChanged="SanitizationDateChanged" />
            <StackPanel x:Name="SanitizationMediaFields">
              <Label Target="{Binding ElementName=SanitizationMediaId}" Content="Workshop media code" />
              <TextBlock Text="Use an opaque code from the workshop record. Leave out full serial numbers and personal paths." />
              <TextBox x:Name="SanitizationMediaId" MaxLength="64"
                       AutomationProperties.Name="Workshop media code" />
            </StackPanel>
            <CheckBox x:Name="ExternalRecordConfirmed"
                      KeyboardNavigation.AcceptsReturn="True"
                      AutomationProperties.Name="Confirm lawful ownership and the external record">
              <TextBlock x:Name="ExternalRecordConfirmation"
                         Text="I confirmed lawful ownership and checked the external record for this device." />
            </CheckBox>
          </StackPanel>
          <TextBlock x:Name="SanitizationInputError" Style="{DynamicResource Trace.ErrorText}" AutomationProperties.LiveSetting="Polite" />
          <Button x:Name="RecordSanitizationButton" Content="Save external result" Style="{DynamicResource Trace.PrimaryButton}" HorizontalAlignment="Left" Click="RecordSanitization" />
        </StackPanel>
        <Button x:Name="CompleteSavedSanitizationButton" Content="Check saved sanitization record"
                Style="{DynamicResource Trace.PrimaryButton}" HorizontalAlignment="Left" Click="CompleteSavedSanitization" IsEnabled="{Binding CanCompleteSavedSanitization}"
                Visibility="Collapsed" />
      </StackPanel>
    </GroupBox>
      </StackPanel>

      <StackPanel x:Name="InspectSurface" Visibility="Collapsed">
        <TextBlock Text="Review device findings" Style="{DynamicResource Trace.TitleText}" AutomationProperties.HeadingLevel="Level1" />
        <TextBlock x:Name="AssessmentInstructions" Margin="0,8,0,12" Style="{DynamicResource Trace.MetaText}"
                   Text="Read device facts and save findings in this job. System settings stay unchanged." />
        <TabControl x:Name="InspectionTabs" AutomationProperties.Name="Inspection views">
          <TabItem x:Name="DeviceFindingsTab" Header="Device findings">
            <StackPanel Margin="0,12,0,0">
              <TextBlock x:Name="FindingsSummary" Style="{DynamicResource Trace.MetaText}" Margin="0,0,0,8" />
              <Grid x:Name="FindingsLayout" SizeChanged="ResizeFindings">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition x:Name="EvidenceColumn" Width="0" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel>
                  <TextBlock Text="Read-only assessment" Style="{DynamicResource Trace.SectionText}" AutomationProperties.HeadingLevel="Level2" />
                  <ListBox x:Name="AssessmentObservations" ItemsSource="{Binding Findings}" MaxHeight="400" Margin="0,8,0,0"
                           SelectionChanged="FindingSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                           ItemContainerStyle="{DynamicResource Trace.FindingRow}"
                           VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                           VirtualizingPanel.ScrollUnit="Pixel" AutomationProperties.Name="Read-only assessment evidence">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <StackPanel>
                          <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Value}" Style="{DynamicResource Trace.MetaText}" />
                          <TextBlock Text="{Binding Evidence}" Style="{DynamicResource Trace.MetaText}" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <Button x:Name="ShowEvidenceButton" Content="Open selected evidence" Click="ShowSelectedEvidence"
                          HorizontalAlignment="Left" IsEnabled="False" />
                </StackPanel>
                <Border x:Name="EvidenceInspector" Grid.Row="1" Visibility="Collapsed" Style="{DynamicResource Trace.EvidencePanel}"
                        DataContext="{Binding SelectedItem, ElementName=AssessmentObservations}">
                  <StackPanel>
                    <TextBlock Text="Selected evidence" Style="{DynamicResource Trace.MetaText}" />
                    <TextBlock Text="{Binding DisplayName}" Style="{DynamicResource Trace.SectionText}" Margin="0,8,0,0"
                               AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Text="{Binding Evidence}" Style="{DynamicResource Trace.MetaText}" Margin="0,4,0,0" />
                    <TextBox Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                             BorderThickness="0" Background="Transparent" Padding="0" TextWrapping="Wrap"
                             AutomationProperties.Name="Selected observation value" Margin="0,8,0,0" />
                    <TextBlock Text="Source" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding Provider}" />
                    <TextBlock Text="{Binding CollectedAt}" Style="{DynamicResource Trace.MetaText}" />
                    <Expander Header="Technical evidence" Margin="0,8,0,0">
                      <TextBox Text="{Binding TechnicalDetails, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                               TextWrapping="Wrap" AutomationProperties.Name="Technical evidence for selected finding" />
                    </Expander>
                    <TextBlock x:Name="BatterySafety" Visibility="Collapsed"
                               Text="Battery reports cannot detect swelling. Swelling requires human inspection."
                               Style="{DynamicResource Trace.AttentionText}" Margin="0,8,0,0" />
                    <Button x:Name="BackToFindings" Content="Back to findings" Click="CloseEvidence" HorizontalAlignment="Left" />
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>
          </TabItem>
          <TabItem x:Name="HardwareChecksTab" Header="Hardware and security checks">
      <StackPanel Margin="0,12,0,0">
        <TextBlock Text="Choose a hardware check or review local administrators and remote access. For a security review, complete the device assessment first." />
        <TextBlock x:Name="FixtureManualNotice" Visibility="Collapsed"
                   Text="A fixture job supports Not run or Not available. A workshop observation is required for Pass or Fail." />
        <TextBlock Text="Use the workshop operator code from Intake. Keep notes free of names, serial numbers, network details and personal content." Style="{DynamicResource Trace.MetaText}" Margin="0,8,0,0" />
        <TextBlock x:Name="ManualBatterySafety" Text="Battery reports cannot detect swelling. Swelling requires human inspection."
                   Style="{DynamicResource Trace.AttentionText}" Margin="0,8,0,0" />
        <TextBlock x:Name="ManualResumeStatus" />
        <StackPanel>
          <Button x:Name="NextManualCheckButton" Content="Go to next unfinished check" Click="SelectNextManualCheck" />
          <Label Target="{Binding ElementName=ManualCheck}" Content="Manual check" />
          <ComboBox x:Name="ManualCheck" DisplayMemberPath="Label" SelectedValuePath="Case.Id" SelectionChanged="ManualCheckChanged"
                    AutomationProperties.Name="Manual hardware or security check" />
          <StackPanel x:Name="ManualInstructions" DataContext="{Binding SelectedItem.Case, ElementName=ManualCheck}"
                      Visibility="Collapsed">
            <TextBlock Text="Procedure" Style="{DynamicResource Trace.SectionText}" Margin="0,12,0,4" />
            <TextBlock Text="{Binding Instructions}" />
            <TextBlock Text="Pass criteria" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBlock Text="{Binding PassCriteria}" />
            <TextBlock Text="Fail criteria" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBlock Text="{Binding FailCriteria}" />
            <TextBlock Text="Cleanup" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBlock Text="{Binding Cleanup}" />
          </StackPanel>
          <TextBlock x:Name="SecurityReviewScope" Visibility="Collapsed" Style="{DynamicResource Trace.MetaText}" />
          <TextBlock x:Name="ManualCurrentResult" AutomationProperties.LiveSetting="Polite" />
          <Expander Header="Last 10 saved results">
            <ListBox x:Name="ManualHistory" MaxHeight="200" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     AutomationProperties.Name="Recent saved results for the selected manual check">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Expander>
          <StackPanel IsEnabled="{Binding CanEditJob}">
            <Label Target="{Binding ElementName=ManualOperatorCode}" Content="Workshop operator code" />
            <TextBox x:Name="ManualOperatorCode" Text="{Binding Text, ElementName=OperatorIdInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     MaxLength="64" AutomationProperties.Name="Workshop operator code for manual result" />
            <Label Target="{Binding ElementName=ManualOutcome}" Content="Check result" />
            <ComboBox x:Name="ManualOutcome" SelectedValuePath="Tag" SelectionChanged="ManualOutcomeChanged"
                      AutomationProperties.Name="Manual check result">
              <ComboBoxItem x:Name="ManualPassOption" Content="Pass" Tag="{x:Static evidence:HumanTestResult.Pass}" />
              <ComboBoxItem x:Name="ManualFailOption" Content="Fail" Tag="{x:Static evidence:HumanTestResult.Fail}" />
              <ComboBoxItem Content="Not run" Tag="{x:Static evidence:HumanTestResult.NotRun}" />
              <ComboBoxItem Content="Not available" Tag="{x:Static evidence:HumanTestResult.NotAvailable}" />
            </ComboBox>
            <StackPanel x:Name="ManualUnavailableFields" Visibility="Collapsed">
              <Label Target="{Binding ElementName=ManualUnavailableReason}" Content="Reason the check is unavailable" />
              <ComboBox x:Name="ManualUnavailableReason" SelectedValuePath="Value" DisplayMemberPath="Label"
                        AutomationProperties.Name="Reason the manual check is unavailable" />
            </StackPanel>
            <StackPanel x:Name="ManualNotesFields">
              <Label Target="{Binding ElementName=ManualNotes}" Content="Brief observation" />
              <TextBox x:Name="ManualNotes" MaxLength="{x:Static manual:ManualTestService.MaximumNotesLength}"
                       TextWrapping="Wrap" AutomationProperties.Name="Brief manual observation" />
            </StackPanel>
            <TextBlock x:Name="ManualInputError" Style="{DynamicResource Trace.ErrorText}" AutomationProperties.LiveSetting="Polite" />
            <Button x:Name="SaveManualResultButton" Content="Save manual result" Style="{DynamicResource Trace.PrimaryButton}" HorizontalAlignment="Left" Click="SaveManualResult" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
          </TabItem>
        </TabControl>
        <Border Style="{DynamicResource Trace.ActionArea}" Margin="0,16,0,0">
          <StackPanel>
            <TextBlock x:Name="AssessmentMessage" Text="{Binding AssessmentStatus}"
                       Focusable="True" KeyboardNavigation.IsTabStop="True"
                       AutomationProperties.Name="{Binding AssessmentStatus}" AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="AssessmentGateMessage" Text="{Binding GateStatus}" Style="{DynamicResource Trace.AttentionText}" />
            <ProgressBar x:Name="AuditAssessmentProgress" IsIndeterminate="True" Height="8" Margin="0,8"
                         Visibility="Collapsed" AutomationProperties.Name="Assessment running" />
            <WrapPanel Margin="0,8,0,0">
              <Button x:Name="GoToSanitizationButton" Content="Go to external sanitization" Margin="0,0,8,4"
                      Click="GoToSanitization" Visibility="Collapsed" />
              <Button x:Name="StartAssessmentButton" Content="Start assessment" Click="StartAssessment" Margin="0,0,8,4"
                      Style="{DynamicResource Trace.PrimaryButton}" IsEnabled="{Binding CanAssess}" />
              <Button x:Name="CancelAssessmentButton" Content="Cancel assessment" Click="CancelAssessment" Margin="0,0,8,4"
                      IsEnabled="{Binding CanCancel}" Visibility="Collapsed" />
              <Button x:Name="ReviewDispositionButton" Content="Review disposition" Click="GoToDisposition" Margin="0,0,8,4"
                      Visibility="Collapsed" />
            </WrapPanel>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel x:Name="DecideSurface" Visibility="Collapsed">
        <disposition:PolicyDispositionView x:Name="PolicyDispositionPanel" />
      </StackPanel>

      <StackPanel x:Name="PrepareSurface" Visibility="Collapsed">
        <plan:PlanReviewView x:Name="PlanReviewPanel" />
        <execution:BrokerExecutionView x:Name="BrokerExecutionPanel" Visibility="Collapsed" />
      </StackPanel>

      <StackPanel x:Name="VerifySurface" Visibility="Collapsed">
        <plan:PackageVerificationView x:Name="PackageVerificationPanel" />
      </StackPanel>

      <StackPanel x:Name="HandoverSurface" Visibility="Collapsed">
        <TextBlock Text="Review handover requirements" Style="{DynamicResource Trace.TitleText}" AutomationProperties.HeadingLevel="Level1" />
        <Border Style="{DynamicResource Trace.ActionArea}" Margin="0,12,0,12">
          <StackPanel>
            <TextBlock x:Name="HandoverStatus" Text="Device handover is still open" Style="{DynamicResource Trace.AttentionText}" FontWeight="SemiBold" />
            <TextBlock Text="Complete the required workshop checks and review whole-device cold-boot verification before handover." Margin="0,4,0,0" />
          </StackPanel>
        </Border>
        <GroupBox Header="Handover mode" AutomationProperties.Name="Handover mode" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock x:Name="HandoverModeMessage" Text="{Binding HandoverModeStatus}" Focusable="True"
                       KeyboardNavigation.IsTabStop="False" AutomationProperties.Name="{Binding HandoverModeStatus}"
                       AutomationProperties.LiveSetting="Polite" />
            <StackPanel x:Name="HandoverModeInput" IsEnabled="{Binding CanRecordHandoverMode}">
              <Label Target="{Binding ElementName=HandoverModeChoice}" Content="Choose assisted or sealed handover" />
              <ComboBox x:Name="HandoverModeChoice" SelectedValuePath="Tag"
                        AutomationProperties.Name="Choose assisted or sealed handover">
                <ComboBoxItem Content="Assisted" Tag="{x:Static handover:HandoverMode.Assisted}" />
                <ComboBoxItem Content="Sealed" Tag="{x:Static handover:HandoverMode.Sealed}" />
              </ComboBox>
              <Label Target="{Binding ElementName=HandoverModeOperator}" Content="Handover operator code" />
              <TextBlock Text="Use your workshop code. Keep names, account details and secrets out of this record." />
              <TextBox x:Name="HandoverModeOperator" MaxLength="64" AutomationProperties.Name="Handover operator code" />
              <TextBlock Text="Changing the mode resets current guidance choices and requires a fresh workshop checklist." />
              <Button x:Name="SaveHandoverModeButton" Content="Save handover mode" Click="SaveHandoverMode"
                      Margin="0,6,0,0" HorizontalAlignment="Left" />
              <StackPanel x:Name="RecipientChoiceFields" Visibility="Collapsed" Margin="0,10,0,0">
                <Label Target="{Binding ElementName=RecipientSetupAreaChoice}" Content="Setup area" />
                <ComboBox x:Name="RecipientSetupAreaChoice" SelectedValuePath="Area" DisplayMemberPath="Label"
                          SelectionChanged="RecipientSetupAreaChanged" AutomationProperties.Name="Setup area" />
                <TextBlock x:Name="RecipientSetupGuidance" TextWrapping="Wrap" />
                <Label Target="{Binding ElementName=RecipientSetupResult}" Content="Recipient guidance choice" />
                <ComboBox x:Name="RecipientSetupResult" SelectedValuePath="Tag" AutomationProperties.Name="Recipient guidance choice">
                  <ComboBoxItem Content="Leave pending" Tag="{x:Static handover:RecipientSetupChoice.Deferred}" />
                  <ComboBoxItem Content="Guidance requested" Tag="{x:Static handover:RecipientSetupChoice.GuidanceRequested}" />
                  <ComboBoxItem Content="Recipient declined" Tag="{x:Static handover:RecipientSetupChoice.Declined}" />
                </ComboBox>
                <CheckBox x:Name="RecipientPresentCheck" Content="The recipient is present and chose this result"
                          Margin="0,6,0,0" />
                <Button x:Name="SaveRecipientChoiceButton" Content="Save guidance choice" Click="SaveRecipientChoice"
                        Margin="0,6,0,0" HorizontalAlignment="Left" />
              </StackPanel>
            </StackPanel>
            <TextBlock x:Name="HandoverModeError" Style="{DynamicResource Trace.ErrorText}" AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="RecipientChoicesSummary" Margin="0,8,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </GroupBox>
        <GroupBox x:Name="ToggleKeysRegion" Header="Recipient Toggle Keys" AutomationProperties.Name="Recipient Toggle Keys"
                  Visibility="Collapsed" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Toggle Keys plays tones for Caps Lock, Num Lock and Scroll Lock. Changes apply to the current Windows user." />
            <WrapPanel Margin="0,8,0,0">
              <Button x:Name="PreviewToggleKeysOnButton" Content="Preview turning on" Click="PreviewToggleKeysOn"
                      IsEnabled="{Binding CanPreviewToggleKeys}" Margin="0,0,8,4" />
              <Button x:Name="PreviewToggleKeysOffButton" Content="Preview turning off" Click="PreviewToggleKeysOff"
                      IsEnabled="{Binding CanPreviewToggleKeys}" Margin="0,0,8,4" />
              <Button x:Name="PreviewToggleKeysRestorationButton" Content="Preview restoring prior setting" Click="PreviewToggleKeysRestoration"
                      IsEnabled="{Binding CanReviewToggleKeysRestoration}" Margin="0,0,8,4" />
            </WrapPanel>
            <TextBlock x:Name="ToggleKeysMessage" Text="{Binding ToggleKeysStatus}" Focusable="True" KeyboardNavigation.IsTabStop="False"
                       AutomationProperties.Name="{Binding ToggleKeysStatus}" AutomationProperties.LiveSetting="Polite" />
            <Button x:Name="KeepToggleKeysUnconfirmedButton" Content="Keep prior attempt unconfirmed" Click="KeepToggleKeysUnconfirmed"
                    HorizontalAlignment="Left" IsEnabled="{Binding CanKeepToggleKeysAttemptUnconfirmed}" Visibility="Collapsed" Margin="0,8,0,0" />
            <StackPanel x:Name="ToggleKeysReviewRegion" Visibility="Collapsed">
              <Label Target="{Binding ElementName=ToggleKeysOperator}" Content="Accessibility setup operator code" />
              <TextBox x:Name="ToggleKeysOperator" AutomationProperties.Name="Accessibility setup operator code" MaxLength="64" />
              <CheckBox x:Name="ToggleKeysConfirmed" Content="The recipient approves this exact change for the current Windows user"
                        Checked="ToggleKeysConfirmationChanged" Unchecked="ToggleKeysConfirmationChanged" Margin="0,8,0,0" />
              <Button x:Name="ApplyToggleKeysButton" Content="Apply approved Toggle Keys change" Click="ApplyToggleKeys"
                      IsEnabled="False" HorizontalAlignment="Left" Margin="0,8,0,0" />
              <TextBlock x:Name="ToggleKeysError" Style="{DynamicResource Trace.ErrorText}" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
          </StackPanel>
        </GroupBox>
        <GroupBox Header="Workshop finalization" AutomationProperties.Name="Workshop finalization checklist">
          <StackPanel>
            <TextBlock x:Name="FinalizationMessage" Text="{Binding FinalizationStatus}"
                       AutomationProperties.Name="{Binding FinalizationStatus}" AutomationProperties.LiveSetting="Polite"
                       Focusable="True" KeyboardNavigation.IsTabStop="False" />
            <Button x:Name="RefreshFinalizationButton" Content="Refresh checklist" Click="RefreshFinalization"
                    IsEnabled="{Binding CanRefreshFinalization}" HorizontalAlignment="Left" Margin="0,8,0,0" />
            <Expander x:Name="WorkshopArtifactScanRegion" Header="Workshop artifact scan" Margin="0,12,0,4">
              <StackPanel>
                <TextBlock Text="Enter only exact workshop account or share names, one per line. Leave unknown lists empty and review those sources manually." />
                <StackPanel IsEnabled="{Binding CanScanArtifacts}">
                  <Label Target="{Binding ElementName=WorkshopAccountNames}" Content="Workshop local account names" />
                  <TextBox x:Name="WorkshopAccountNames" MaxLength="2048" AcceptsReturn="True" IsUndoEnabled="False"
                           TextWrapping="Wrap" MaxHeight="94" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Workshop local account names" />
                  <Label Target="{Binding ElementName=WorkshopShareNames}" Content="Workshop local share names" />
                  <TextBox x:Name="WorkshopShareNames" MaxLength="2048" AcceptsReturn="True" IsUndoEnabled="False"
                           TextWrapping="Wrap" MaxHeight="94" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Workshop local share names" />
                  <Button x:Name="ScanWorkshopArtifactsButton" Content="Scan workshop artifacts" Click="ScanWorkshopArtifacts"
                          HorizontalAlignment="Left" Margin="0,8,0,0" />
                </StackPanel>
                <Button x:Name="CancelWorkshopArtifactScanButton" Content="Cancel artifact scan" Click="CancelWorkshopArtifactScan"
                        IsEnabled="{Binding CanCancelArtifactScan}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                <TextBlock x:Name="ArtifactScanMessage" Text="{Binding ArtifactScanStatus}" Margin="0,8,0,0"
                           AutomationProperties.Name="{Binding ArtifactScanStatus}" AutomationProperties.LiveSetting="Polite"
                           Focusable="True" KeyboardNavigation.IsTabStop="False" />
                <TextBlock x:Name="ArtifactScanResult" Text="{Binding ArtifactScanFindings}" Margin="0,4,0,4"
                           TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="Review indications in the relevant checklist item. Preserve required workshop records and handle residue through authorized Windows or workshop procedures." />
              </StackPanel>
            </Expander>
            <StackPanel x:Name="FinalizationChecklistFields" Visibility="Collapsed">
              <Label Target="{Binding ElementName=FinalizationCheck}" Content="Workshop check" />
              <ComboBox x:Name="FinalizationCheck" DisplayMemberPath="Caption" SelectedValuePath="Id"
                        SelectionChanged="FinalizationCheckChanged" AutomationProperties.Name="Workshop check" />
              <TextBlock x:Name="FinalizationGuidance" Margin="0,8,0,0" />
              <TextBlock x:Name="FinalizationFinding" FontWeight="SemiBold" Margin="0,4,0,8"
                         AutomationProperties.LiveSetting="Polite" />
              <StackPanel x:Name="FinalizationRecordFields">
                <Label Target="{Binding ElementName=FinalizationOutcomeInput}" Content="Result of your check" />
                <ComboBox x:Name="FinalizationOutcomeInput" SelectedValuePath="Tag" SelectionChanged="FinalizationOutcomeChanged"
                          AutomationProperties.Name="Result of your check">
                  <ComboBoxItem Content="Checked and clear" Tag="{x:Static finalization:FinalizationOutcome.Passed}" />
                  <ComboBoxItem Content="Problem found" Tag="{x:Static finalization:FinalizationOutcome.Failed}" />
                  <ComboBoxItem Content="Could not confirm" Tag="{x:Static finalization:FinalizationOutcome.Unknown}" />
                  <ComboBoxItem x:Name="FinalizationNotApplicable" Content="Not applicable" Tag="{x:Static finalization:FinalizationOutcome.NotApplicable}" />
                </ComboBox>
                <StackPanel x:Name="FinalizationReasonFields" Visibility="Collapsed">
                  <Label Target="{Binding ElementName=FinalizationReasonInput}" Content="Reason the check does not apply" />
                  <ComboBox x:Name="FinalizationReasonInput" DisplayMemberPath="Label" SelectedValuePath="Reason"
                            AutomationProperties.Name="Reason the check does not apply" />
                </StackPanel>
                <Label Target="{Binding ElementName=FinalizationOperatorCode}" Content="Workshop operator code" />
                <TextBlock Text="Use your local workshop code. Leave out names, account details, and secrets." />
                <TextBox x:Name="FinalizationOperatorCode" MaxLength="64" AutomationProperties.Name="Workshop operator code" />
                <TextBlock x:Name="FinalizationInputError" Style="{DynamicResource Trace.ErrorText}"
                           AutomationProperties.LiveSetting="Polite" />
                <Button x:Name="SaveFinalizationButton" Content="Save check result" Click="SaveFinalization"
                        HorizontalAlignment="Left" Margin="0,8,0,0" />
              </StackPanel>
              <Expander x:Name="FinalizationHistoryRegion" Header="Saved confirmations for this check" Margin="0,12,0,0">
                <TextBox x:Name="FinalizationHistory" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                         MinHeight="42" MaxHeight="180" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="Saved confirmations for this check" />
              </Expander>
            </StackPanel>
          </StackPanel>
        </GroupBox>
    <GroupBox Header="Recipient guide" AutomationProperties.Name="Recipient guide" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Text="Preview the plain-language guide before saving a copy to print or give to the recipient." />
        <Button x:Name="PreviewRecipientGuideButton" Content="Preview recipient guide" Click="PreviewRecipientGuide"
                IsEnabled="{Binding CanPreviewRecipientGuide}" HorizontalAlignment="Left" Margin="0,8,0,0" />
        <TextBlock x:Name="RecipientGuideMessage" Text="{Binding RecipientGuideStatus}" Focusable="True"
                   KeyboardNavigation.IsTabStop="False" AutomationProperties.Name="{Binding RecipientGuideStatus}"
                   AutomationProperties.LiveSetting="Polite" Margin="0,8,0,0" />
        <StackPanel x:Name="RecipientGuidePreviewRegion" Visibility="Collapsed" Margin="0,8,0,0">
          <TextBox x:Name="RecipientGuidePreviewBox" Text="{Binding RecipientGuidePreview, Mode=OneWay}"
                   IsReadOnly="True" IsReadOnlyCaretVisible="True" TextWrapping="Wrap"
                   MinHeight="120" MaxHeight="320" VerticalScrollBarVisibility="Auto"
                   AutomationProperties.Name="Recipient guide preview" />
          <Button x:Name="SaveRecipientGuideButton" Content="Save printable guide" Click="SaveRecipientGuide"
                  IsEnabled="{Binding CanSaveRecipientGuide}" HorizontalAlignment="Left" Margin="0,8,0,0" />
        </StackPanel>
      </StackPanel>
    </GroupBox>
    <GroupBox x:Name="WorkshopReportRegion" Header="Workshop report" AutomationProperties.Name="Workshop report">
      <StackPanel>
        <TextBlock Text="Generate a restricted report from this saved job. Keep it with workshop records." />
        <TextBlock x:Name="ReportArtifactDetails" Style="{DynamicResource Trace.MetaText}" Margin="0,8,0,0" />
        <WrapPanel Margin="0,8,0,0">
          <Button x:Name="GenerateReportButton" Style="{DynamicResource Trace.PrimaryButton}" Margin="0,0,8,4" Content="Generate workshop report" Click="GenerateWorkshopReport"
                IsEnabled="{Binding CanGenerateReport}" />
          <Button x:Name="OpenReportButton" Margin="0,0,8,4" Content="Open workshop report" Click="OpenWorkshopReport"
                IsEnabled="{Binding CanOpenReport}" />
          <Button x:Name="CancelReportButton" Margin="0,0,8,4" Content="Cancel report operation" Click="CancelReport"
                Visibility="Collapsed" />
        </WrapPanel>
        <TextBlock x:Name="ReportMessage" Text="{Binding ReportStatus}" Focusable="True"
                   KeyboardNavigation.IsTabStop="True" AutomationProperties.Name="{Binding ReportStatus}"
                   AutomationProperties.LiveSetting="Polite" />
        <TextBox x:Name="WorkshopReportPreview" Text="{Binding ReportPreview, Mode=OneWay}"
                 Visibility="Collapsed" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                 MinHeight="120" MaxHeight="320" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="Restricted workshop report preview" />
      </StackPanel>
    </GroupBox>
    <GroupBox Header="Sanitized support archive" AutomationProperties.Name="Sanitized support archive">
      <StackPanel>
        <TextBlock Text="Review the two fixed files before exporting. The ZIP is saved in a protected ThirdLifeSupport folder at the local location you choose. Share a copy only for the support case." />
        <Button x:Name="PreviewSupportButton" Content="Preview support archive" Click="PreviewSupport"
                HorizontalAlignment="Left" Margin="0,8,0,0" IsEnabled="{Binding CanPreviewSupport}" />
        <Button x:Name="CancelSupportButton" Content="Cancel support operation" Click="CancelSupport"
                HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="Collapsed" />
        <TextBlock x:Name="SupportExportMessage" Text="{Binding SupportExportStatus}" Focusable="True"
                   KeyboardNavigation.IsTabStop="False" AutomationProperties.Name="{Binding SupportExportStatus}"
                   AutomationProperties.LiveSetting="Polite" Margin="0,8,0,0" />
        <TextBlock x:Name="SupportHistoryMessage" Text="{Binding SupportHistoryStatus}" AutomationProperties.LiveSetting="Polite"
                   Style="{DynamicResource Trace.AttentionText}" />
        <Button x:Name="RetrySupportAuditButton" Content="Retry saving the export record" Click="RetrySupportAudit"
                Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,8,0,0" />
        <StackPanel x:Name="SupportRecoveryRegion" Visibility="Collapsed" Margin="0,8,0,0">
          <Label Target="{Binding ElementName=PendingSupportExport}" Content="Unconfirmed support archive" />
          <ComboBox x:Name="PendingSupportExport" ItemsSource="{Binding PendingSupportExports}" DisplayMemberPath="InternalSupportId"
                    AutomationProperties.Name="Unconfirmed support archive" />
          <Label Target="{Binding ElementName=SupportRecoveryOperator}" Content="Support recovery operator code" />
          <TextBox x:Name="SupportRecoveryOperator" AutomationProperties.Name="Support recovery operator code" MaxLength="64" />
          <Button x:Name="RecoverSupportExportButton" Content="Choose original folder and verify archive" Click="RecoverSupportExport"
                  HorizontalAlignment="Left" Margin="0,8,0,0" />
          <TextBlock x:Name="SupportRecoveryError" AutomationProperties.LiveSetting="Polite" Style="{DynamicResource Trace.ErrorText}" />
        </StackPanel>
        <StackPanel x:Name="SupportPreviewRegion" Visibility="Collapsed" Margin="0,8,0,0">
          <TextBlock Text="{Binding SupportPreviewSummary}" />
          <TextBlock Text="The manifest shows the support code, versions and available generic machine details. The observations file shows check and package outcomes." />
          <TextBlock Text="Keep exported copies only for the support case. Review their deletion within 30 days unless your workshop has a documented reason to keep them longer." />
          <TabControl x:Name="SupportFiles" ItemsSource="{Binding SupportPreview.Files}" SelectedIndex="0"
                      AutomationProperties.Name="Files in the support archive" Margin="0,8,0,0">
            <TabControl.ItemTemplate>
              <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
              <DataTemplate>
                <TextBox Text="{Binding Contents, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                         TextWrapping="Wrap" MinHeight="120" MaxHeight="260" VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="{Binding Name}" />
              </DataTemplate>
            </TabControl.ContentTemplate>
          </TabControl>
          <Label Target="{Binding ElementName=SupportOperatorCode}" Content="Support export operator code" />
          <TextBox x:Name="SupportOperatorCode" MaxLength="64" AutomationProperties.Name="Support export operator code" />
          <CheckBox x:Name="SupportExportApproved" Checked="SupportApprovalChanged" Unchecked="SupportApprovalChanged"
                    Content="I reviewed both files and approve this exact support archive" Margin="0,8,0,0" />
          <Button x:Name="ExportSupportButton" Content="Choose folder and export" Click="ExportSupport"
                  HorizontalAlignment="Left" Margin="0,8,0,0" IsEnabled="False" />
          <TextBlock x:Name="SupportInputError" AutomationProperties.LiveSetting="Polite"
                     Style="{DynamicResource Trace.ErrorText}" />
        </StackPanel>
      </StackPanel>
    </GroupBox>
    <GroupBox Header="Handover sign-off" AutomationProperties.Name="Handover sign-off" Margin="0,12,0,0">
      <StackPanel>
        <Button x:Name="ReviewHandoverButton" Content="Review handover readiness" Click="ReviewHandover" IsEnabled="{Binding CanReviewHandover}"
                HorizontalAlignment="Left" />
        <TextBlock x:Name="HandoverCompletionMessage" Text="{Binding HandoverCompletionStatus}" Focusable="True"
                   KeyboardNavigation.IsTabStop="False" AutomationProperties.Name="{Binding HandoverCompletionStatus}"
                   AutomationProperties.LiveSetting="Polite" Margin="0,8,0,0" />
        <ItemsControl ItemsSource="{Binding HandoverBlockers}" Focusable="False" AutomationProperties.Name="Handover requirements to review">
          <ItemsControl.ItemTemplate>
            <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl ItemsSource="{Binding HandoverOutputSummary}" Focusable="False" AutomationProperties.Name="Reviewed handover outputs">
          <ItemsControl.ItemTemplate>
            <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel x:Name="HandoverCompletionActions" Visibility="Collapsed">
          <Label Target="{Binding ElementName=HandoverCompletionOperator}" Content="Sign-off or omission operator code" />
          <TextBox x:Name="HandoverCompletionOperator" MaxLength="64" AutomationProperties.Name="Sign-off or omission operator code" />
          <Label Target="{Binding ElementName=SupportOmissionReasonChoice}" Content="Support archive omission reason" />
          <ComboBox x:Name="SupportOmissionReasonChoice" SelectedValuePath="Tag" AutomationProperties.Name="Support archive omission reason">
            <ComboBoxItem Content="No support request" Tag="{x:Static handover:SupportBundleOmissionReason.NoSupportRequest}" />
            <ComboBoxItem Content="Privacy choice" Tag="{x:Static handover:SupportBundleOmissionReason.PrivacyChoice}" />
          </ComboBox>
          <Button x:Name="RecordSupportOmissionButton" Content="Record support archive omission" Click="RecordSupportOmission" HorizontalAlignment="Left" Margin="0,8,0,0" />
          <CheckBox x:Name="HandoverCompletionConfirmed" Content="I reviewed the saved evidence and confirm the handover"
                    IsEnabled="{Binding CanSignOffHandover}" Margin="0,8,0,0"
                    Checked="HandoverConfirmationChanged" Unchecked="HandoverConfirmationChanged" />
          <Button x:Name="CompleteHandoverButton" Content="Record handover sign-off" Click="CompleteHandover"
                  IsEnabled="False" HorizontalAlignment="Left" Margin="0,8,0,0" />
          <TextBlock x:Name="HandoverCompletionInputError" AutomationProperties.LiveSetting="Polite" Style="{DynamicResource Trace.ErrorText}" />
        </StackPanel>
      </StackPanel>
    </GroupBox>
      </StackPanel>
    </Grid>
  </StackPanel>
</UserControl>
