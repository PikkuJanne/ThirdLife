<UserControl x:Class="ThirdLife.UI.Features.PlanReview.PlanReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:execution="clr-namespace:ThirdLife.UI.Features.Execution">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="PlanReviewVisibility" />
  </UserControl.Resources>
  <GroupBox x:Name="PlanReviewRegion" Header="Preparation plan" Focusable="True"
            KeyboardNavigation.IsTabStop="True" AutomationProperties.Name="Preparation plan">
    <StackPanel>
      <TextBlock Text="Review the proposed changes before approving a plan."
                 TextWrapping="Wrap" />
      <StackPanel Margin="0,6,0,0" IsEnabled="{Binding CanReviewPlan}">
        <Label Content="Preparation profile" Target="{Binding ElementName=PlanProfileSelector}" />
        <ComboBox x:Name="PlanProfileSelector" ItemsSource="{Binding PlanProfiles}"
                  SelectedItem="{Binding SelectedPlanProfile, Mode=TwoWay}" DisplayMemberPath="DisplayName"
                  AutomationProperties.Name="Preparation profile" />
        <ItemsControl ItemsSource="{Binding PlanCapabilities}" Margin="0,6,0,0"
                      AutomationProperties.Name="Workshop capabilities">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <CheckBox IsChecked="{Binding IsIncluded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="{Binding Label}" Margin="0,2,0,2">
                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
              </CheckBox>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
      <Button x:Name="BuildPlanReviewButton" IsEnabled="{Binding CanBuildPlanReview}" Click="BuildPlanReview"
              AutomationProperties.Name="Build plan review">
        <TextBlock Text="Build plan review" TextWrapping="Wrap" />
      </Button>
      <TextBlock x:Name="PlanStatusMessage" Text="{Binding PlanReviewStatus, NotifyOnTargetUpdated=True}"
                 TextWrapping="Wrap" Focusable="True" KeyboardNavigation.IsTabStop="True"
                 AutomationProperties.LiveSetting="Polite" TargetUpdated="AnnounceStatus" />
      <StackPanel Visibility="{Binding IsPackageProfile, Converter={StaticResource PlanReviewVisibility}}">
        <TextBlock x:Name="PackageSourceMessage" Text="{Binding PackageSourceStatus, NotifyOnTargetUpdated=True}"
                   TextWrapping="Wrap" Focusable="True" KeyboardNavigation.IsTabStop="True"
                   AutomationProperties.LiveSetting="Polite" TargetUpdated="AnnounceStatus" />
        <Button x:Name="CancelPackageButton" Content="Cancel package operation" IsEnabled="{Binding CanCancelPackage}"
                Click="CancelPackageOperation" Margin="0,4,0,4" HorizontalAlignment="Left" />
      </StackPanel>
      <StackPanel Margin="0,8,0,0"
                  Visibility="{Binding HasPlanReview, Converter={StaticResource PlanReviewVisibility}}">
        <TextBlock x:Name="PlanResultTitle" Text="{Binding PlanReviewTitle}" TextWrapping="Wrap"
                   Focusable="True" KeyboardNavigation.IsTabStop="True" FontWeight="SemiBold"
                   AutomationProperties.HeadingLevel="Level3" />
        <Expander x:Name="PlanDetailsExpander" AutomationProperties.Name="Plan details"
                  Focusable="True" KeyboardNavigation.IsTabStop="False"
                  Expanded="ExpandPlanDetails" IsVisibleChanged="UpdateDetailsVisibility">
          <Expander.Header>
            <TextBlock Text="Plan details" TextWrapping="Wrap" />
          </Expander.Header>
          <TextBox x:Name="PlanDetailsText" Text="{Binding PlanReviewDetails, Mode=OneWay}"
                   TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True"
                   IsReadOnlyCaretVisible="True" MaxHeight="320"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                   PreviewKeyDown="ClosePlanDetailsOnEscape"
                   AutomationProperties.Name="Plan details and impact"
                   AutomationProperties.HelpText="Press Escape to close the details and return to the heading." />
        </Expander>
        <StackPanel Visibility="{Binding IsPackageProfile, Converter={StaticResource PlanReviewVisibility}}">
          <TextBlock x:Name="PackageVerificationNotice"
                     Text="After installation, ThirdLife checks the exact version for all users. It briefly starts Notepad++ with no documents and closes the instance it started."
                     TextWrapping="Wrap" Focusable="True" KeyboardNavigation.IsTabStop="True" />
          <Label Content="Workshop operator code for this approval" Target="{Binding ElementName=PackageOperator}" />
          <TextBox x:Name="PackageOperator" MaxLength="64" Text="{Binding PackageOperatorCode, UpdateSourceTrigger=PropertyChanged}"
                   IsEnabled="{Binding CanEditPackageOperator}" AutomationProperties.Name="Workshop operator code for this approval" />
        </StackPanel>
        <StackPanel Visibility="{Binding HasBrokerPlan, Converter={StaticResource PlanReviewVisibility}}">
          <Label Content="Workshop operator code for this approval" Target="{Binding ElementName=BrokerOperator}" />
          <TextBox x:Name="BrokerOperator" MaxLength="64" Text="{Binding BrokerOperatorCode, UpdateSourceTrigger=PropertyChanged}"
                   IsEnabled="{Binding CanEditBrokerOperator}" AutomationProperties.Name="Workshop operator code for this approval" />
        </StackPanel>
        <WrapPanel Margin="0,6,0,0">
          <Button x:Name="ApprovePlanReviewButton" Content="Approve plan" Click="ApprovePlanReview"
                  IsEnabled="{Binding CanApprovePlanReview}" Margin="0,0,8,4" />
          <Button x:Name="DeclinePlanReviewButton" Content="Decline plan" Click="DeclinePlanReview"
                  IsEnabled="{Binding CanDeclinePlanReview}" Margin="0,0,8,4" />
          <Button x:Name="InstallPackageButton" Content="Install approved package"
                  Visibility="{Binding IsPackageProfile, Converter={StaticResource PlanReviewVisibility}}"
                  IsEnabled="{Binding CanInstallPackage}" Click="InstallPackage" Margin="0,0,0,4" />
        </WrapPanel>
      </StackPanel>
      <execution:BrokerExecutionView x:Name="BrokerExecutionPanel" Margin="0,6,0,0"
                                     Visibility="{Binding ShowsBrokerExecution, Converter={StaticResource PlanReviewVisibility}}" />
      <TextBox x:Name="SavedPackageHistory" Text="{Binding PackageHistoryText, Mode=OneWay}" TextWrapping="Wrap"
               IsReadOnly="True" IsReadOnlyCaretVisible="True" AcceptsReturn="True" MaxHeight="220"
               VerticalScrollBarVisibility="Auto" Margin="0,6,0,0"
               Visibility="{Binding HasPackageHistory, Converter={StaticResource PlanReviewVisibility}}"
               AutomationProperties.Name="Saved machine-wide setup journal" />
      <StackPanel Visibility="{Binding ShowsPackageRecovery, Converter={StaticResource PlanReviewVisibility}}">
        <Button x:Name="CheckPackageRecoveryButton" Content="Check installed package state"
                IsEnabled="{Binding CanCheckPackageRecovery}" Click="CheckPackageRecovery"
                Margin="0,4,0,4" HorizontalAlignment="Left" />
        <TextBlock x:Name="PackageRecoveryMessage" Text="{Binding PackageRecoveryStatus, NotifyOnTargetUpdated=True}"
                   TextWrapping="Wrap" Focusable="True" KeyboardNavigation.IsTabStop="True"
                   AutomationProperties.LiveSetting="Polite" TargetUpdated="AnnounceStatus" />
      </StackPanel>
    </StackPanel>
  </GroupBox>
</UserControl>
