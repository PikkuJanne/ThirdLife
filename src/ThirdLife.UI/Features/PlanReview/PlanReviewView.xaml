<UserControl x:Class="ThirdLife.UI.Features.PlanReview.PlanReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SizeChanged="ResizeMaterialImpact">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="PlanReviewVisibility" />
  </UserControl.Resources>
  <StackPanel>
    <TextBlock Text="Review exactly what will change" Style="{DynamicResource Trace.TitleText}"
               AutomationProperties.HeadingLevel="Level1" TextWrapping="Wrap" />
    <TextBlock Text="Save the exact plan approval before requesting installation."
               Style="{DynamicResource Trace.MetaText}" TextWrapping="Wrap" Margin="0,4,0,16" />

    <TextBlock Text="{Binding PlanReviewAccess}" Style="{DynamicResource Trace.AttentionText}" TextWrapping="Wrap" />
    <Border Style="{DynamicResource Trace.EvidencePanel}" Margin="0,0,0,16">
      <StackPanel>
        <Label Content="Preparation profile" Target="{Binding ElementName=PlanProfileSelector}" />
        <ComboBox x:Name="PlanProfileSelector" ItemsSource="{Binding VisiblePlanProfiles}"
                  IsEnabled="{Binding CanChoosePlanProfile}"
                  SelectedItem="{Binding SelectedPlanProfile, Mode=TwoWay}" DisplayMemberPath="DisplayName"
                  AutomationProperties.Name="Preparation profile" />
        <ItemsControl ItemsSource="{Binding PlanCapabilities}" Margin="0,4,0,0"
                      IsEnabled="{Binding CanChoosePlanProfile}" AutomationProperties.Name="Workshop capabilities">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <CheckBox IsChecked="{Binding IsIncluded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="{Binding Label}" Margin="0,0,0,4">
                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
              </CheckBox>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button x:Name="BuildPlanReviewButton" IsEnabled="{Binding CanBuildPlanReview}" Click="BuildPlanReview"
                Content="Build plan review" HorizontalAlignment="Left" Margin="0,8,0,0"
                AutomationProperties.Name="Build plan review" />
      </StackPanel>
    </Border>
    <TextBlock x:Name="PlanStatusMessage" Text="{Binding PlanReviewStatus, NotifyOnTargetUpdated=True}"
               TextWrapping="Wrap" Focusable="True" KeyboardNavigation.IsTabStop="True" Margin="0,0,0,8"
               AutomationProperties.LiveSetting="Polite" TargetUpdated="AnnounceStatus" />
    <StackPanel Visibility="{Binding ShowsPackageOperationStatus, Converter={StaticResource PlanReviewVisibility}}">
      <TextBlock x:Name="PackagePreflightMessage" Text="{Binding PackagePreflightStatus, NotifyOnTargetUpdated=True}"
                 Visibility="{Binding HasPackagePreflightStatus, Converter={StaticResource PlanReviewVisibility}}"
                 Margin="0,0,0,8" TextWrapping="Wrap" Focusable="True" KeyboardNavigation.IsTabStop="True"
                 AutomationProperties.LiveSetting="Polite" TargetUpdated="AnnounceStatus"
                 IsVisibleChanged="AnnouncePreflightVisibility" />
      <TextBlock x:Name="PackageSourceMessage" Text="{Binding PackageSourceStatus, NotifyOnTargetUpdated=True}"
                 TextWrapping="Wrap" Focusable="True" KeyboardNavigation.IsTabStop="True"
                 AutomationProperties.LiveSetting="Polite" TargetUpdated="AnnounceStatus" />
      <Button x:Name="CancelPackageButton" Content="Cancel package operation" IsEnabled="{Binding CanCancelPackage}"
              Visibility="{Binding IsPackageOperationRunning, Converter={StaticResource PlanReviewVisibility}}"
              Click="CancelPackageOperation" Margin="0,8,0,0" HorizontalAlignment="Left" />
    </StackPanel>
    <StackPanel Margin="0,16,0,0"
                Visibility="{Binding HasPlanReview, Converter={StaticResource PlanReviewVisibility}}">
      <TextBlock Text="{Binding PlanReviewChanges}" Style="{DynamicResource Trace.AttentionText}" TextWrapping="Wrap" />
      <Border Style="{DynamicResource Trace.EvidencePanel}">
        <StackPanel>
          <TextBlock x:Name="PlanResultTitle" Text="{Binding PlanReviewTitle}" TextWrapping="Wrap"
                     Style="{DynamicResource Trace.SectionText}" Focusable="True" KeyboardNavigation.IsTabStop="True"
                     AutomationProperties.HeadingLevel="Level2" />
          <StackPanel Visibility="{Binding HasMaterialPlanImpact, Converter={StaticResource PlanReviewVisibility}}">
            <TextBlock Text="{Binding PlanReview.Identity}" TextWrapping="Wrap" Margin="0,4,0,0"
                       FontSize="{DynamicResource Trace.TypeBody}" />
            <TextBlock Text="{Binding PlanReview.Scope}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Style="{DynamicResource Trace.MetaText}" />
          </StackPanel>
        </StackPanel>
      </Border>
      <ItemsControl x:Name="MaterialImpactItems" ItemsSource="{Binding PlanReview.MaterialImpact}" Margin="0,16,0,8"
                    Visibility="{Binding HasMaterialPlanImpact, Converter={StaticResource PlanReviewVisibility}}"
                    Focusable="False" KeyboardNavigation.IsTabStop="False" AutomationProperties.Name="Material plan impact">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="{DynamicResource Trace.BorderPassiveBrush}" BorderThickness="0,1,0,0"
                    Margin="0,0,16,8" Padding="0,8,4,4">
              <StackPanel>
                <TextBlock Text="{Binding Label}" Style="{DynamicResource Trace.MetaText}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Value}" TextWrapping="Wrap" Margin="0,4,0,0" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Expander x:Name="PlanDetailsExpander" AutomationProperties.Name="Plan details"
                Focusable="True" KeyboardNavigation.IsTabStop="False"
                Expanded="ExpandPlanDetails" IsVisibleChanged="UpdateDetailsVisibility">
        <Expander.Header>
          <TextBlock Text="Package trust and exact plan details" TextWrapping="Wrap" />
        </Expander.Header>
        <TextBox x:Name="PlanDetailsText" Text="{Binding PlanReviewDetails, Mode=OneWay}"
                 TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True"
                 IsReadOnlyCaretVisible="True" MaxHeight="320"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                 PreviewKeyDown="ClosePlanDetailsOnEscape"
                 AutomationProperties.Name="Plan details and impact"
                 AutomationProperties.HelpText="Press Escape to close the details and return to the heading." />
      </Expander>
      <Border Style="{DynamicResource Trace.ActionArea}" Margin="0,16,0,0">
        <StackPanel>
          <StackPanel Visibility="{Binding IsPackageProfile, Converter={StaticResource PlanReviewVisibility}}">
            <TextBlock x:Name="PackageVerificationNotice"
                       Text="After installation, ThirdLife checks the exact version for all users. It briefly starts the package application with no documents and closes the instance it started. Reopening the job can continue an interrupted check."
                       TextWrapping="Wrap" Focusable="True" KeyboardNavigation.IsTabStop="True" />
            <Label Content="Workshop operator code" Target="{Binding ElementName=PackageOperator}" />
            <TextBox x:Name="PackageOperator" MaxLength="64"
                     Text="{Binding PackageOperatorCode, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding CanEditPackageOperator}" AutomationProperties.Name="Workshop operator code" />
          </StackPanel>
          <StackPanel Visibility="{Binding ShowsBrokerOperator, Converter={StaticResource PlanReviewVisibility}}">
            <Label Content="Workshop operator code" Target="{Binding ElementName=BrokerOperator}" />
            <TextBox x:Name="BrokerOperator" MaxLength="64"
                     Text="{Binding BrokerOperatorCode, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding CanEditBrokerOperator}" AutomationProperties.Name="Workshop operator code" />
          </StackPanel>
          <WrapPanel Margin="0,8,0,0"
                     Visibility="{Binding ShowsPlanDecision, Converter={StaticResource PlanReviewVisibility}}">
            <Button x:Name="ApprovePlanReviewButton" Content="Approve plan" Click="ApprovePlanReview"
                    Style="{DynamicResource Trace.PrimaryButton}" IsEnabled="{Binding CanApprovePlanReview}" Margin="0,0,8,4" />
            <Button x:Name="DeclinePlanReviewButton" Content="Decline plan" Click="DeclinePlanReview"
                    IsEnabled="{Binding CanDeclinePlanReview}" Margin="0,0,0,4" />
          </WrapPanel>
          <Button x:Name="InstallPackageButton" Content="Install approved package"
                  Style="{DynamicResource Trace.PrimaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0"
                  Visibility="{Binding ShowsPackageInstall, Converter={StaticResource PlanReviewVisibility}}"
                  IsEnabled="{Binding CanInstallPackage}" Click="InstallPackage" />
          <ItemsControl x:Name="ActionSkipItems" ItemsSource="{Binding ActionSkipChoices}"
                        Visibility="{Binding ShowsActionSkipChoices, Converter={StaticResource PlanReviewVisibility}}"
                        IsEnabled="{Binding CanSkipApprovedAction}" AutomationProperties.Name="Skip approved actions">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,8,0,0">
                  <TextBlock Text="{Binding Consequence}" TextWrapping="Wrap" />
                  <Button Content="{Binding Label}" Click="SkipApprovedAction" HorizontalAlignment="Left"
                          AutomationProperties.HelpText="{Binding Consequence}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
    <GroupBox Header="Windows Update" AutomationProperties.Name="Windows Update" Margin="0,16,0,0"
              Visibility="{Binding ShowsWindowsUpdates, Converter={StaticResource PlanReviewVisibility}}">
      <StackPanel>
        <TextBlock Text="Scan the configured Windows Update service using the network. This build supports inventory only. Update downloads and installation are unavailable."
                   TextWrapping="Wrap" />
        <WrapPanel Margin="0,8,0,4">
          <Button x:Name="ScanWindowsUpdatesButton" Content="Scan for Windows updates" Click="ScanWindowsUpdates"
                  IsEnabled="{Binding CanScanWindowsUpdates}" Margin="0,0,8,4" />
          <Button x:Name="CancelWindowsUpdateScanButton" Content="Cancel update scan" Click="CancelWindowsUpdateScan"
                  IsEnabled="{Binding CanCancelWindowsUpdateScan}" Margin="0,0,0,4"
                  Visibility="{Binding IsWindowsUpdateScanning, Converter={StaticResource PlanReviewVisibility}}" />
        </WrapPanel>
        <TextBlock x:Name="WindowsUpdateMessage" Text="{Binding WindowsUpdateStatusText, NotifyOnTargetUpdated=True}"
                   TextWrapping="Wrap" Focusable="True" KeyboardNavigation.IsTabStop="True"
                   AutomationProperties.LiveSetting="Polite" TargetUpdated="AnnounceStatus" />
        <TextBox Text="{Binding WindowsUpdateInventory, Mode=OneWay}" AutomationProperties.Name="Last successful update inventory"
                 Visibility="{Binding HasWindowsUpdateInventory, Converter={StaticResource PlanReviewVisibility}}"
                 IsReadOnly="True" IsReadOnlyCaretVisible="True" TextWrapping="Wrap" AcceptsReturn="True"
                 MaxHeight="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0" />
      </StackPanel>
    </GroupBox>
  </StackPanel>
</UserControl>
