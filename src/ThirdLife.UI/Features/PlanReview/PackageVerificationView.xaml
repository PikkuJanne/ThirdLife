<UserControl x:Class="ThirdLife.UI.Features.PlanReview.PackageVerificationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:recovery="clr-namespace:ThirdLife.UI.Features.Recovery">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="VerifyVisibility" />
  </UserControl.Resources>
  <StackPanel>
    <TextBlock x:Name="VerificationHeading" Text="Review recorded outcomes" Style="{DynamicResource Trace.TitleText}"
               Focusable="True" KeyboardNavigation.IsTabStop="False"
               AutomationProperties.HeadingLevel="Level1" TextWrapping="Wrap" />
    <TextBlock Text="Review saved preparation outcomes and independent checks."
               Style="{DynamicResource Trace.MetaText}" TextWrapping="Wrap" Margin="0,4,0,16" />
    <TextBlock x:Name="MaintenancePauseMessage" Text="{Binding MaintenancePhaseStatus, NotifyOnTargetUpdated=True}"
               Visibility="{Binding HasMaintenancePhaseStatus, Converter={StaticResource VerifyVisibility}}"
               AutomationProperties.LiveSetting="Polite" TargetUpdated="AnnounceStatus" Focusable="True"
               KeyboardNavigation.IsTabStop="True" TextWrapping="Wrap" Margin="0,0,0,8" />
    <Button x:Name="ContinueMaintenanceButton" Content="Check and continue maintenance"
            Visibility="{Binding ShowsMaintenanceContinuation, Converter={StaticResource VerifyVisibility}}"
            IsEnabled="{Binding CanContinueMaintenance}" Click="ContinueMaintenance"
            AutomationProperties.HelpText="Scan Windows Update and check the saved phase before continuing. You can close and reopen this job at any phase boundary."
            HorizontalAlignment="Left" Margin="0,0,0,12" />
    <Button x:Name="CancelMaintenanceCheckButton" Content="Cancel maintenance check"
            Visibility="{Binding IsCheckingMaintenance, Converter={StaticResource VerifyVisibility}}"
            IsEnabled="{Binding CanCancelWindowsUpdate}" Click="CancelMaintenanceCheck"
            HorizontalAlignment="Left" Margin="0,0,0,12" />
    <Border Style="{DynamicResource Trace.EvidencePanel}" Margin="0,0,0,16"
            Visibility="{Binding HasWindowsUpdateHistory, Converter={StaticResource VerifyVisibility}}">
      <StackPanel>
        <TextBlock Text="Saved Windows Update result" Style="{DynamicResource Trace.SectionText}"
                   AutomationProperties.HeadingLevel="Level2" TextWrapping="Wrap" />
        <TextBlock x:Name="SavedUpdateResult" Text="{Binding WindowsUpdateStatusText}" Margin="0,4,0,0"
                   Focusable="True" KeyboardNavigation.IsTabStop="True" TextWrapping="Wrap" />
        <TextBlock Text="{Binding WindowsUpdateVerificationText}" Margin="0,4,0,0"
                   Visibility="{Binding HasWindowsUpdateVerification, Converter={StaticResource VerifyVisibility}}"
                   Focusable="True" KeyboardNavigation.IsTabStop="True" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <Border Style="{DynamicResource Trace.EvidencePanel}" Margin="0,0,0,16"
            Visibility="{Binding HasPreparationDisposition, Converter={StaticResource VerifyVisibility}}">
      <StackPanel>
        <TextBlock Text="Preparation action disposition" Style="{DynamicResource Trace.SectionText}"
                   TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2" />
        <TextBlock x:Name="PreparationDispositionMessage"
                   Text="{Binding PreparationDispositionStatus, NotifyOnTargetUpdated=True}" TextWrapping="Wrap"
                   Focusable="True" KeyboardNavigation.IsTabStop="True" Margin="0,4,0,0"
                   AutomationProperties.LiveSetting="Polite" TargetUpdated="AnnounceStatus" />
        <TextBox x:Name="PreparationOutcomeDetails" Text="{Binding PreparationOutcomes, Mode=OneWay}" TextWrapping="Wrap" IsReadOnly="True"
                 IsReadOnlyCaretVisible="True" AcceptsReturn="True" MaxHeight="220" Margin="0,8,0,0"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                 Visibility="{Binding HasPreparationOutcomes, Converter={StaticResource VerifyVisibility}}"
                 AutomationProperties.Name="Preparation action outcomes" />
      </StackPanel>
    </Border>
    <Border Style="{DynamicResource Trace.EvidencePanel}"
            Visibility="{Binding ShowsVerifyEmptyState, Converter={StaticResource VerifyVisibility}}">
      <StackPanel>
        <TextBlock Text="No package action recorded" Style="{DynamicResource Trace.SectionText}" TextWrapping="Wrap"
                   AutomationProperties.HeadingLevel="Level2" />
        <TextBlock Text="Build and review a supported plan in Prepare to see the proposed package operation."
                   TextWrapping="Wrap" Margin="0,4,0,0" />
      </StackPanel>
    </Border>

    <Border Style="{DynamicResource Trace.EvidencePanel}" Margin="0,0,0,16"
            Visibility="{Binding HasPackageHistory, Converter={StaticResource VerifyVisibility}}">
      <StackPanel>
        <TextBlock Text="Latest saved package result" Style="{DynamicResource Trace.MetaText}" Margin="0,0,0,4"
                   TextWrapping="Wrap" />
        <TextBlock Text="{Binding LatestPackageIdentity}" Style="{DynamicResource Trace.SectionText}"
                   AutomationProperties.HeadingLevel="Level2" TextWrapping="Wrap" />
        <TextBlock x:Name="LatestResult" Text="{Binding LatestPackageOutcome, NotifyOnTargetUpdated=True}"
                   Focusable="True" KeyboardNavigation.IsTabStop="True"
                   TextWrapping="Wrap" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite" TargetUpdated="AnnounceStatus" />
      </StackPanel>
    </Border>
    <Border Style="{DynamicResource Trace.ActionArea}" Margin="0,0,0,16"
            Visibility="{Binding ShowsPackageVerificationActions, Converter={StaticResource VerifyVisibility}}">
      <StackPanel>
        <TextBlock x:Name="PackageRecoveryMessage" Text="{Binding PackageRecoveryStatus, NotifyOnTargetUpdated=True}"
                   Visibility="{Binding ShowsPackageRecovery, Converter={StaticResource VerifyVisibility}}"
                   TextWrapping="Wrap" Focusable="True" KeyboardNavigation.IsTabStop="True"
                   AutomationProperties.LiveSetting="Polite" TargetUpdated="AnnounceStatus" />
        <TextBlock x:Name="RetryPlanStatus" Text="{Binding PlanReviewStatus, NotifyOnTargetUpdated=True}"
                   Visibility="{Binding ShowsPackageVerificationPlanStatus, Converter={StaticResource VerifyVisibility}}"
                   TextWrapping="Wrap" Focusable="True" KeyboardNavigation.IsTabStop="True"
                   AutomationProperties.LiveSetting="Polite" TargetUpdated="AnnounceStatus" />
        <TextBlock x:Name="RetryPreflightMessage" Text="{Binding PackagePreflightStatus, NotifyOnTargetUpdated=True}"
                   Visibility="{Binding HasPackagePreflightStatus, Converter={StaticResource VerifyVisibility}}"
                   TextWrapping="Wrap" Focusable="True" KeyboardNavigation.IsTabStop="True"
                   AutomationProperties.LiveSetting="Polite" TargetUpdated="AnnounceStatus"
                   IsVisibleChanged="AnnouncePreflightVisibility" />
        <TextBlock x:Name="PackageRetryMessage" Text="{Binding PackageRetryStatusText, NotifyOnTargetUpdated=True}"
                   Visibility="{Binding HasPackageRetryStatus, Converter={StaticResource VerifyVisibility}}"
                   TextWrapping="Wrap" Focusable="True" KeyboardNavigation.IsTabStop="True"
                   AutomationProperties.LiveSetting="Polite" TargetUpdated="AnnounceStatus" />
        <TextBlock x:Name="PackageVerificationActivity" Text="{Binding PackageSourceStatus, NotifyOnTargetUpdated=True}"
                   Visibility="{Binding ShowsPackageInstallActivity, Converter={StaticResource VerifyVisibility}}"
                   TextWrapping="Wrap" Focusable="True" KeyboardNavigation.IsTabStop="True"
                   AutomationProperties.LiveSetting="Polite" TargetUpdated="AnnounceStatus" />
        <Button x:Name="CheckPackageRecoveryButton" Content="Check installed package state"
                Style="{DynamicResource Trace.PrimaryButton}" HorizontalAlignment="Left"
                Visibility="{Binding OffersPackageRecoveryCheck, Converter={StaticResource VerifyVisibility}}"
                IsEnabled="{Binding CanCheckPackageRecovery}" Click="CheckPackageRecovery" Margin="0,8,0,0" />
        <Button x:Name="RetryPackageButton" Content="Retry saved package" HorizontalAlignment="Left"
                Visibility="{Binding ShowPackageRetry, Converter={StaticResource VerifyVisibility}}"
                IsEnabled="{Binding CanRetryPackage}" Click="RetryPackage" Margin="0,8,0,0" />
        <Button x:Name="CancelPackageRecoveryButton" Content="Cancel package verification" HorizontalAlignment="Left"
                Visibility="{Binding ShowsPackageRecoveryCancellation, Converter={StaticResource VerifyVisibility}}"
                IsEnabled="{Binding CanCancelPackageRecovery}" Click="CancelPackageRecovery" Margin="0,8,0,0" />
        <Button x:Name="CancelSavedPackageOperationButton" Content="Cancel package operation" HorizontalAlignment="Left"
                Visibility="{Binding ShowsPackageInstallActivity, Converter={StaticResource VerifyVisibility}}"
                IsEnabled="{Binding CanCancelPackage}" Click="CancelSavedPackageOperation" Margin="0,8,0,0" />
      </StackPanel>
    </Border>
    <recovery:RebootRecoveryView x:Name="RebootRecoveryPanel" Margin="0,0,0,16" />

    <StackPanel Visibility="{Binding HasPackageHistory, Converter={StaticResource VerifyVisibility}}">
      <TextBlock Text="Recent package journal entries" Style="{DynamicResource Trace.SectionText}"
                 AutomationProperties.HeadingLevel="Level2" TextWrapping="Wrap" Margin="0,0,0,8" />
      <ItemsControl ItemsSource="{Binding PackageJournal}" AutomationProperties.Name="Recent package journal entries">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="{DynamicResource Trace.BorderPassiveBrush}" BorderThickness="0,1,0,0"
                    Padding="0,8,0,8">
              <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{DynamicResource Trace.SectionText}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Timestamp}" Style="{DynamicResource Trace.MetaText}"
                           TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock Text="{Binding Outcome}" TextWrapping="Wrap" Margin="0,4,0,0" />
                <Expander Margin="0,4,0,0">
                  <Expander.Header>
                    <TextBlock Text="Exact journal details" TextWrapping="Wrap" />
                  </Expander.Header>
                  <TextBox Text="{Binding Provenance, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                           TextWrapping="Wrap" AutomationProperties.Name="Exact journal details" />
                </Expander>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Expander x:Name="PackageHistoryExpander" Margin="0,8,0,0">
        <Expander.Header>
          <TextBlock Text="Saved package attempt summary" TextWrapping="Wrap" />
        </Expander.Header>
        <TextBox x:Name="SavedPackageHistory" Text="{Binding PackageHistoryText, Mode=OneWay}" TextWrapping="Wrap"
                 IsReadOnly="True" IsReadOnlyCaretVisible="True" AcceptsReturn="True" MaxHeight="220"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="Saved machine-wide setup journal" />
      </Expander>
    </StackPanel>

    <Expander Visibility="{Binding HasBrokerHistory, Converter={StaticResource VerifyVisibility}}" Margin="0,16,0,0">
      <Expander.Header>
        <TextBlock Text="Saved broker qualification journal" TextWrapping="Wrap" />
      </Expander.Header>
      <TextBox Text="{Binding BrokerHistoryText, Mode=OneWay}" TextWrapping="Wrap" AcceptsReturn="True"
               IsReadOnly="True" IsReadOnlyCaretVisible="True" MaxHeight="220" VerticalScrollBarVisibility="Auto"
               AutomationProperties.Name="Saved broker qualification history" />
    </Expander>
    <Border Style="{DynamicResource Trace.EvidencePanel}" Margin="0,16,0,0">
      <StackPanel>
        <TextBlock Text="Device acceptance remains open" Style="{DynamicResource Trace.AttentionText}"
                   AutomationProperties.HeadingLevel="Level2" TextWrapping="Wrap" />
        <TextBlock Text="Handover requires applicable device checks, cold-boot verification and finalization."
                   TextWrapping="Wrap" Margin="0,4,0,0" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
