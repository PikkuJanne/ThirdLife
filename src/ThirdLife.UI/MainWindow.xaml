<Window x:Class="ThirdLife.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:manual="clr-namespace:ThirdLife.UI.Features.ManualTests"
        Title="ThirdLife Setup Core" Height="840" Width="1220"
        MinHeight="260" MinWidth="320" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource Trace.BgCanvasBrush}" Foreground="{DynamicResource Trace.TextPrimaryBrush}"
        FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}"
        FontSize="{DynamicResource Trace.TypeUi}">
  <Window.Resources>
    <ItemsPanelTemplate x:Key="WideWorkflow"><StackPanel /></ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="CompactWorkflow"><WrapPanel /></ItemsPanelTemplate>
  </Window.Resources>
  <ScrollViewer x:Name="ShellScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                PreviewMouseWheel="ScrollFromWheel" Focusable="True" KeyboardNavigation.IsTabStop="False"
                AutomationProperties.Name="Workshop workspace">
    <StackPanel>
      <Border Background="{DynamicResource Trace.BgSurfaceBrush}" BorderBrush="{DynamicResource Trace.BorderPassiveBrush}"
              BorderThickness="0,0,0,1" Padding="24,12">
        <DockPanel x:Name="ProductBar" LastChildFill="False" SizeChanged="ResizeProductBar">
          <StackPanel x:Name="ProductIdentity" DockPanel.Dock="Left" Margin="0,0,16,0" VerticalAlignment="Center">
            <TextBlock Text="ThirdLife" Style="{DynamicResource Trace.TitleText}" />
            <TextBlock Text="Setup Core" Style="{DynamicResource Trace.MetaText}" />
          </StackPanel>
          <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
            <Button x:Name="JobsButton" Content="Jobs" Click="GoToJobs" Margin="0,0,12,0" />
            <Label Content="Appearance" Target="{Binding ElementName=AppearanceChoice}" VerticalAlignment="Center" />
            <ComboBox x:Name="AppearanceChoice" AutomationProperties.Name="Appearance" MinWidth="86"
                      SelectionChanged="ChangeAppearance">
              <ComboBoxItem Content="Dark" />
              <ComboBoxItem Content="Light" />
            </ComboBox>
          </WrapPanel>
        </DockPanel>
      </Border>
      <Grid x:Name="WorkflowLayout" SizeChanged="ResizeWorkflow" MinHeight="550">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="NavigationColumn" Width="176" />
          <ColumnDefinition x:Name="WorkColumn" Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border x:Name="WorkflowRail" Background="{DynamicResource Trace.BgSurfaceBrush}" Grid.RowSpan="2"
                BorderBrush="{DynamicResource Trace.BorderPassiveBrush}" BorderThickness="0,0,1,0" Padding="12,16">
          <StackPanel>
            <TextBlock Text="Device workflow" Style="{DynamicResource Trace.MetaText}" Margin="8,0,0,8" />
            <ListBox x:Name="StageList" AutomationProperties.Name="Device workflow stage"
                     SelectionChanged="SelectStage" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     KeyboardNavigation.DirectionalNavigation="Contained"
                     ItemContainerStyle="{DynamicResource Trace.StageItem}" ItemsPanel="{StaticResource WideWorkflow}">
              <ListBoxItem x:Name="IntakeStage" Tag="Intake" AutomationProperties.Name="Intake" AutomationProperties.AutomationId="StageIntake">
                <StackPanel><TextBlock Text="Intake" FontWeight="SemiBold" /><TextBlock x:Name="IntakeNote" Style="{DynamicResource Trace.MetaText}" /></StackPanel>
              </ListBoxItem>
              <ListBoxItem x:Name="InspectStage" Tag="Inspect" AutomationProperties.Name="Inspect" AutomationProperties.AutomationId="StageInspect">
                <StackPanel><TextBlock Text="Inspect" FontWeight="SemiBold" /><TextBlock x:Name="InspectNote" Style="{DynamicResource Trace.MetaText}" /></StackPanel>
              </ListBoxItem>
              <ListBoxItem x:Name="DecideStage" Tag="Decide" AutomationProperties.Name="Decide" AutomationProperties.AutomationId="StageDecide">
                <StackPanel><TextBlock Text="Decide" FontWeight="SemiBold" /><TextBlock x:Name="DecideNote" Style="{DynamicResource Trace.MetaText}" /></StackPanel>
              </ListBoxItem>
              <ListBoxItem x:Name="PrepareStage" Tag="Prepare" AutomationProperties.Name="Prepare" AutomationProperties.AutomationId="StagePrepare">
                <StackPanel><TextBlock Text="Prepare" FontWeight="SemiBold" /><TextBlock x:Name="PrepareNote" Style="{DynamicResource Trace.MetaText}" /></StackPanel>
              </ListBoxItem>
              <ListBoxItem x:Name="VerifyStage" Tag="Verify" AutomationProperties.Name="Verify" AutomationProperties.AutomationId="StageVerify">
                <StackPanel><TextBlock Text="Verify" FontWeight="SemiBold" /><TextBlock x:Name="VerifyNote" Style="{DynamicResource Trace.MetaText}" /></StackPanel>
              </ListBoxItem>
              <ListBoxItem x:Name="HandoverStage" Tag="Handover" AutomationProperties.Name="Handover" AutomationProperties.AutomationId="StageHandover">
                <StackPanel><TextBlock Text="Handover" FontWeight="SemiBold" /><TextBlock x:Name="HandoverNote" Style="{DynamicResource Trace.MetaText}" /></StackPanel>
              </ListBoxItem>
            </ListBox>
            <Border x:Name="LocalRecords" BorderBrush="{DynamicResource Trace.BorderPassiveBrush}"
                    BorderThickness="0,1,0,0" Margin="8,24,8,0" Padding="0,12,0,0">
              <TextBlock Text="Assessment records stay on this device. Downloads are named in each plan."
                         Style="{DynamicResource Trace.MetaText}" />
            </Border>
          </StackPanel>
        </Border>
        <StackPanel x:Name="WorkspaceColumn" Grid.Column="1" Grid.RowSpan="2">
          <TextBlock x:Name="NavigationStatus" AutomationProperties.LiveSetting="Polite"
                     AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}"
                     Height="0" Focusable="False" />
          <manual:AuditWorkspaceView x:Name="AuditView" />
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</Window>
